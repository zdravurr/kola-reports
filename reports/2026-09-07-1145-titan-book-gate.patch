+"""Order-book entry gate for Titan — TRADING DISCIPLINE, NOT A MEASURED EDGE.
+
+🔴 READ THIS BEFORE CHANGING ANYTHING HERE.
+
+WHAT THIS IS. Two rules a discretionary trader would follow without being asked:
+  A  do not buy into a wall     — refuse when the nearest OPPOSING wall is both
+                                  unusually large FOR THIS SIDE and very close;
+  B  do not enter where there   — refuse when the book leans against the entry
+     is nothing to enter into     harder than it ever normally does.
+
+🔴 WHAT THIS IS NOT, AND THE SENTENCE NO FUTURE SESSION MAY DELETE.
+    THIS GATE IS NOT A MEASURED EDGE AND MUST NEVER BE DESCRIBED AS ONE.
+    The 2026-09-07 design pass established that this gate would NOT have refused
+    vpos 102 or vpos 103 — the two stop-outs that prompted it. It is being built
+    because a bot that buys into a wall is doing something a trader would not do,
+    not because the data promises money. That is DISCIPLINE, not a measured edge.
+    If a later pass measures it and finds no edge, that is the EXPECTED result and
+    is NOT grounds to remove it. Grounds to remove it are: it fires too often, it
+    fires asymmetrically by side, or it refuses trades a trader would take.
+
+WHY IN CODE AND NOT IN THE PROMPT. Titan's prompt already carries a "HARD RULE —
+opposing walls" instruction and the advisor overrode it in the open: on vpos 102
+it read an ASK-heavy book — the book leaning AGAINST a LONG — and wrote
+"imbalance ask-heavy favors entry", a straight inversion; on vpos 103 it named the
+opposing wall's 91st percentile, called it "genuine", wrote "proceed with caution"
+and entered. The prompt's own text calls p90+ the thick region. A rule that must
+hold every time cannot live in a text generator.
+
+🔴 THE RULER, AND WHY IT IS NOT SOL'S. `_NEAR_MULT_BREAKS` below is cut from
+Titan's OWN nearest-opposing wall multiples, on EACH SIDE SEPARATELY. Mercury-SOL's
+table is the wrong ruler for BTC and is not merely mis-scaled — it is inert:
+replayed over Titan's own gate population, every Titan wall reads MEDIAN p5 on
+SOL's scale, the SHORT side never exceeds p18, and clause A refuses 0.00 % of
+SHORTs while SOL's 0.20 % distance cut covers 91.5 % of Titan's LONG books instead
+of the intended 25 %. Substituting SOL's constants gives 15.96 % LONG / 0.00 %
+SHORT — a side ban wearing a percentile's name, which is exactly how the EMA
+envelope gate died on 2026-08-07 and why SOL's own floor was re-cut on 2026-08-14.
+
+🔴 THE POPULATION. The breaks, the distance cuts and the lean floors are all cut
+over the rows that REACH THIS GATE — the 199 rows carrying `advisor_book_json`
+(94 LONG / 105 SHORT, 2026-08-03 → 2026-09-07), i.e. the survivors of the HTF
+cascade, the EMA envelope gate, the score bar, the filter list and the risk gate.
+NOT over all book snapshots. Cutting p2 on the 79,745-row `orderbook_density`
+collector table instead gives LONG 0.3506 / SHORT 0.3933, which replays to 0.00 %
+LONG and 3.81 % SHORT on the population the gate actually judges: same quantity,
+wrong population, and it is the category error SOL's 2026-08-14 re-cut records.
+Anyone re-cutting this: cut over rows that reached the gate, never over all books.
+
+Record: reports/2026-09-07-1145-titan-the-book-gate-designed-and-one-clause-refused-a-winner.md
+"""
+
+import logging
+
+log = logging.getLogger(__name__)
+
+# Percentile breakpoints of the NEAREST OPPOSING wall's `mult`, PER SIDE.
+# Cut from the 199-row gate population named above (94 LONG / 105 SHORT).
+# Re-cut only from that same quantity (nearest opposing wall, one side, rows that
+# reached the gate) — never from all rendered walls and never from the collector.
+#
+# 🔴 NOTE HOW DIFFERENT THE TWO SIDES ARE, AND WHY ONE TABLE COULD NOT SERVE BOTH:
+# p90 is x14.84 on a LONG and x6.82 on a SHORT. Titan's wall bucket is 5.0 USD on
+# an ~80,000 USD instrument; opposing ASK walls stack far larger than opposing BID
+# walls. A single nominal multiple would be "top decile" on one side and
+# "unreachable" on the other.
+_NEAR_MULT_BREAKS = {
+    'LONG':  ((5, 4.10), (10, 4.23), (15, 4.30), (20, 4.40), (25, 4.50),
+              (30, 4.60), (35, 4.85), (40, 5.00), (45, 5.20), (50, 5.30),
+              (55, 5.61), (60, 5.96), (65, 7.53), (70, 7.81), (75, 8.32),
+              (80, 8.54), (85, 9.14), (90, 14.84), (95, 24.97)),
+    'SHORT': ((5, 4.20), (10, 4.30), (15, 4.50), (20, 4.50), (25, 4.60),
+              (30, 4.72), (35, 4.80), (40, 4.90), (45, 5.10), (50, 5.20),
+              (55, 5.22), (60, 5.30), (65, 5.40), (70, 5.58), (75, 5.80),
+              (80, 6.00), (85, 6.14), (90, 6.82), (95, 7.54)),
+}
+
+
+def side_pctl(mult, direction):
+    """Percentile of `mult` among NEAREST-OPPOSING walls on `direction`'s side.
+
+    Returns None when not rankable. 🔴 None means NOT RANKABLE and is never to be
+    read as 'ordinary' — the caller must not refuse on it. Same discipline as
+    main._rank_walls: a number we cannot justify is worse than no number.
+    """
+    if not isinstance(mult, (int, float)) or isinstance(mult, bool) or mult != mult:
+        return None
+    brk = _NEAR_MULT_BREAKS.get(direction)
+    if not brk:
+        return None
+    m = float(mult)
+    if m <= brk[0][1]:
+        return float(brk[0][0])
+    if m >= brk[-1][1]:
+        return 99.0
+    for i in range(1, len(brk)):
+        p_lo, v_lo = brk[i - 1]
+        p_hi, v_hi = brk[i]
+        if m < v_hi:
+            if v_hi == v_lo:
+                return float(p_hi)
+            return round(p_lo + (p_hi - p_lo) * (m - v_lo) / (v_hi - v_lo), 1)
+    return 99.0
+
+
+def read_book(walls, direction):
+    """Extract the gate's facts from a liquidity_zones.fetch_pre_trade_walls dict.
+
+    🔴 SHAPE-GUARDED ON PURPOSE. Titan's `trades` table holds TWO different book
+    objects: `advisor_book_json` (the OKX books-full depth-4000 dict this gate and
+    the advisor share) and `orderbook_json` (the BingX depth-20 microstructure
+    capture written AFTER the decision, at a different depth, on a different
+    venue — on vpos 91 it reported a wall the advisor's book did not contain).
+    Reading one as the other silently produces nonsense. This accepts only the
+    OKX-4000 shape, identified by `wall_threshold_mult` + `depth`.
+
+    Returns a facts dict, or None when the book is unusable — the caller must
+    then FAIL OPEN and say so.
+    """
+    if not isinstance(walls, dict):
+        return None
+    if 'wall_threshold_mult' not in walls or 'depth' not in walls:
+        return None                      # not the OKX-4000 shape — refuse to guess
+    mid = walls.get('mid')
+    if (not isinstance(mid, (int, float)) or isinstance(mid, bool)
+            or mid != mid or not mid):
+        return None                      # mid missing, zero, NaN or non-numeric
+    bids = walls.get('walls_bid') or []
+    asks = walls.get('walls_ask') or []
+    if not isinstance(bids, list) or not isinstance(asks, list):
+        return None
+    if direction == 'LONG':
+        opposing, supporting = asks, bids
+        above = lambda p: p > mid
+        below = lambda p: p < mid
+    elif direction == 'SHORT':
+        opposing, supporting = bids, asks
+        above = lambda p: p < mid
+        below = lambda p: p > mid
+    else:
+        return None                      # unknown direction — never guess a side
+    opp = [w for w in opposing
+           if isinstance(w, dict) and isinstance(w.get('price'), (int, float))
+           and above(w['price'])]
+    sup = [w for w in supporting
+           if isinstance(w, dict) and isinstance(w.get('price'), (int, float))
+           and below(w['price'])]
+    near = min(opp, key=lambda w: abs(w['price'] - mid)) if opp else None
+    imb = walls.get('imbalance')
+    # `imbalance` is the BID share. Lean TOWARD the proposed side.
+    lean = (float(imb) if direction == 'LONG' else 1.0 - float(imb)) \
+        if isinstance(imb, (int, float)) and not isinstance(imb, bool) else None
+    return {
+        'mid':          mid,
+        'opp_mult':     (near.get('mult') if near else None),
+        'opp_price':    (near.get('price') if near else None),
+        'opp_pctl':     side_pctl(near.get('mult') if near else None, direction),
+        'opp_dist_pct': (abs(near['price'] - mid) / mid * 100.0 if near else None),
+        'n_opposing':   len(opp),
+        'n_supporting': len(sup),
+        'lean':         lean,
+    }
+
+
+def evaluate(walls, direction):
+    """Decide whether the book refuses this entry.
+
+    Returns {'refuse': bool, 'clause': 'A'|'B'|'AB'|None, 'reason': str, 'facts': {...}}
+
+    🔴 FAILS OPEN, ALWAYS. An unreadable book, a missing wall, an unrankable
+    multiplier, a missing imbalance, a mid of zero, an import that is not there —
+    every one of them ADMITS. A liquidity gate that blocks when it cannot see is a
+    gate that turns an OKX outage into a trading halt, and OKX is a third venue
+    this bot does not trade on. A bug in this file must be able to let a trade
+    through; it must never be able to invent a refusal.
+    """
+    out = {'refuse': False, 'clause': None, 'reason': '', 'facts': {}}
+    try:
+        from config import (BOOK_GATE_ENABLED, BOOK_GATE_CLAUSE_A_ENABLED,
+                            BOOK_GATE_CLAUSE_B_ENABLED, BOOK_GATE_WALL_PCTL,
+                            BOOK_GATE_WALL_DIST_PCT, BOOK_GATE_LEAN_FLOOR,
+                            BOOK_GATE_MIN_SUPPORTING)
+    except Exception as _cfg_err:                      # flags absent/misspelt
+        out['reason'] = f'config unreadable — ADMITTED (gate fails open): {_cfg_err}'
+        return out
+    if not BOOK_GATE_ENABLED:
+        out['reason'] = 'book gate disabled'
+        return out
+    f = read_book(walls, direction)
+    if f is None:
+        out['reason'] = ('book unreadable or not the OKX-4000 shape — ADMITTED '
+                         '(gate fails open)')
+        return out
+    out['facts'] = f
+
+    # ── CLAUSE A — do not trade into a wall ──────────────────────────────────
+    # Both conditions required. A huge wall 0.6 % away is not in the way; a tiny
+    # wall 0.01 % away is not a wall. Only "big AND close" is the thing a trader
+    # would refuse. The distance cut is PER SIDE — see the config comment: on
+    # Titan the two sides' distance distributions differ by 2.2x at the same
+    # quantile, so a single number would itself be the side ban.
+    _dist_thr = (BOOK_GATE_WALL_DIST_PCT.get(direction)
+                 if isinstance(BOOK_GATE_WALL_DIST_PCT, dict) else None)
+    a = (BOOK_GATE_CLAUSE_A_ENABLED
+         and f['opp_pctl'] is not None
+         and f['opp_pctl'] >= BOOK_GATE_WALL_PCTL
+         and f['opp_dist_pct'] is not None
+         and _dist_thr is not None
+         and f['opp_dist_pct'] <= _dist_thr)
+
+    # ── CLAUSE B — do not enter where there is nothing to enter into ─────────
+    # 🔴 SHIPS DISARMED ON TITAN. BOTH of its halves were measured on the gate's
+    # own population and BOTH failed, in the two ways this project already knows:
+    #   · supporting-wall floor at SOL's value of 1 refuses 4.26 % of LONGs and
+    #     0.00 % of SHORTs — an unbounded side ratio;
+    #   · the lean floor at p2 of each side's own distribution fires exactly ONCE
+    #     in 94 LONG rows, and that once is vpos 94 (+0.8650R, trail) — the single
+    #     largest winner of the live batch. A rule whose only historical refusal
+    #     is the best trade in the sample refuses a trade a trader would take.
+    # The numbers stay in config so the clause can be armed the day the population
+    # says otherwise. See BOOK_GATE_CLAUSE_B_ENABLED for the full record.
+    floor = (BOOK_GATE_LEAN_FLOOR.get(direction)
+             if isinstance(BOOK_GATE_LEAN_FLOOR, dict) else None)
+    b = (BOOK_GATE_CLAUSE_B_ENABLED
+         and (f['n_supporting'] < BOOK_GATE_MIN_SUPPORTING
+              or (f['lean'] is not None and floor is not None
+                  and f['lean'] < floor)))
+
+    if not (a or b):
+        out['reason'] = 'book clear'
+        return out
+    out['refuse'] = True
+    out['clause'] = ('AB' if (a and b) else ('A' if a else 'B'))
+    bits = []
+    if a:
+        bits.append(f"opposing wall x{f['opp_mult']:.1f} at p{f['opp_pctl']:.0f} "
+                    f"(this side) only {f['opp_dist_pct']:.4f}% away "
+                    f"(<= {_dist_thr}%)")
+    if b:
+        if f['n_supporting'] < BOOK_GATE_MIN_SUPPORTING:
+            bits.append(f"no supporting depth ({f['n_supporting']} walls)")
+        else:
+            bits.append(f"book leans {f['lean']:.4f} against this side "
+                        f"(< {floor:.4f} = p2 for {direction})")
+    out['reason'] = ' AND '.join(bits)
+    return out
