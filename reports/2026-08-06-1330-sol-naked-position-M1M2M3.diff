+class EntryFailSafeError(RuntimeError):
+    """Raised by the entry SL fail-safe. Carries the `trades` status this outcome
+    MUST be recorded under.
+
+    THE POINT IS THE STATUS. Before today the fail-safe `return None`d, and the
+    caller turns None into 'observed_skipped' — the status that everywhere else in
+    this codebase means *the advisor said execute but nothing was sent*. So the
+    worst state this bot can reach (funded, unstopped, emergency close ALSO failed)
+    was indistinguishable in the book from a routine non-event. It is now countable:
+
+        SELECT status, COUNT(*) FROM trades
+         WHERE status LIKE 'sl_failed%' OR status='naked_position_unprotected'
+
+    `naked` marks the branch where we do NOT know the position is flat.
+    """
+
+    def __init__(self, message, *, status, naked):
+        super().__init__(message)
+        self.status = status
+        self.naked  = naked
+
+
+def _record_naked_position(symbol, position_side, *, stage, detail):
+    """Persist a naked/unknown-protection event to its OWN table.
+
+    A Telegram message is not state. The operator reads it on a phone, the process
+    restarts, and nothing on disk remembers that a position may be open with no
+    stop. This row is what _assert_exchange_matches_db_at_boot cross-references, so
+    the alert survives the restart that the alert itself asks the operator to make.
+    Never raises: a bookkeeping failure must not mask the emergency it is recording.
+    """
+    try:
+        with sqlite3.connect(DB_PATH) as conn:
+            conn.execute(
+                "CREATE TABLE IF NOT EXISTS naked_position_alerts ("
+                "  id INTEGER PRIMARY KEY AUTOINCREMENT,"
+                "  ts TEXT, symbol TEXT, position_side TEXT,"
+                "  stage TEXT, detail TEXT, resolved INTEGER DEFAULT 0)"
+            )
+            conn.execute(
+                "INSERT INTO naked_position_alerts(ts, symbol, position_side, stage, detail) "
+                "VALUES (?,?,?,?,?)",
+                (datetime.now(timezone.utc).isoformat(), symbol, position_side,
+                 stage, str(detail)[:2000]),
+            )
+    except Exception as e:                                     # pragma: no cover
+        print(f"{LOG_PREFIX}[NAKED] could not persist alert: {e}", flush=True)
+
+
+def _sl_failsafe(symbol, position_side, *, attempted_sl):
+    """The stop could not be set. Emergency-close, then CLASSIFY the outcome.
+
+    🔴 M2. This ALWAYS raises — there is no outcome here that may share a return
+    value with "no order was placed". Three distinct statuses:
+
+      • naked_position_unprotected — the emergency close raised. Either
+        _execute_close_position hit POS_UNKNOWN (a single Tor blip is enough; it
+        raises rather than closing blind — correct, and it lands here) or the close
+        order itself failed. WE DO NOT KNOW THE POSITION IS FLAT and we DO know it
+        has no stop. Loud Telegram + a durable row.
+      • sl_failed_position_closed — the close succeeded. Contained, still not routine.
+      • sl_failed_no_position     — the venue reports FLAT: the entry never filled,
+        so nothing was ever naked. Benign, and now visible instead of silent.
+    """
+    print(f"{LOG_PREFIX}[SL-FAIL-SAFE] SL failed 3× (attempted {attempted_sl}) — "
+          f"emergency market close of {position_side}", flush=True)
+    send_tg(f"🚨 <b>SL FAILED 3×</b> — emergency close of {position_side} {symbol}\n"
+            f"The stop could not be set at {attempted_sl}. Closing the position now.")
+    try:
+        res = _execute_close_position(symbol, position_side, reason='sl_failsafe')
+    except Exception as ec:
+        # 🔴 THE WORST STATE THIS BOT CAN REACH.
+        _record_naked_position(symbol, position_side, stage='sl_failsafe_close_failed',
+                               detail=f'attempted_sl={attempted_sl} err={ec}')
+        print(f"{LOG_PREFIX}[SL-FAIL-SAFE] 🔴 emergency close FAILED: {ec}", flush=True)
+        send_tg(f"🔴🔴🔴 <b>NAKED POSITION — EMERGENCY CLOSE FAILED</b>\n"
+                f"{symbol} {position_side}\n"
+                f"The stop could NOT be set (3 attempts) and the emergency close "
+                f"then FAILED too: <code>{str(ec)[:200]}</code>\n"
+                f"<b>A funded position may be OPEN on Bybit with NO STOP.</b>\n"
+                f"🔴 The account is on <b>CROSS margin</b> — the exposure is the "
+                f"wallet balance, not the $100 notional.\n"
+                f"🔴 <b>NOTHING WILL FIX THIS BY ITSELF.</b>\n"
+                f"<b>Do now:</b> 1) open Bybit, check for a {position_side} position "
+                f"on {symbol}; 2) if it exists, set a stop or close it BY HAND; "
+                f"3) the bot will not manage it.")
+        raise EntryFailSafeError(
+            f'SL failed and emergency close failed for {symbol} {position_side}: {ec}',
+            status='naked_position_unprotected', naked=True) from ec
