+def _assert_exchange_matches_db_at_boot(symbol):
+    """🔴 M1(d) — READ THE VENUE AT BOOT AND REFUSE TO START QUIET.
+
+    THE GAP THIS CLOSES. Both existing reconcilers read the DATABASE:
+    _reconcile_open_virtual_positions does `SELECT … FROM virtual_positions` and
+    never INSERTs; _reconcile_active_positions starts from active_positions and
+    returns early when it is empty — exactly the state left by an entry that could
+    not be booked. So a Bybit position with no DB row was invisible FOREVER: no
+    restart adopted it, and the only control was a Telegram message. Titan carries
+    assert_exchange_matches_db_at_boot for precisely this; SOL had no counterpart.
+
+    WHAT IT DOES NOT DO: it does not fabricate a virtual_positions row. Adopting a
+    position means inventing its entry price, its 1R, its breakeven and its partial
+    leg from data we do not have — the same fabrication _read_entry_fill refuses.
+    It makes the position VISIBLE and BLOCKS the side, which is the honest half.
+
+    ON A FAILED READ IT REPORTS UNKNOWN, NEVER CLEAN. Concluding "no orphans" from
+    a read that failed is the F1 defect this codebase already fixed everywhere else.
+    """
+    _BOOT_ORPHAN_SIDES.clear()
+    state_by_side = {}
+    try:
+        positions = tor_retry.with_socks_retry(
+            exchange, lambda ex: ex.fetch_positions([symbol]),
+            label='positions.bootassert')
+    except Exception as e:
+        print(f"{LOG_PREFIX}[BOOT-ASSERT] venue read FAILED ({e}) — state UNKNOWN. "
+              f"NOT claiming clean.", flush=True)
+        send_tg(f"⚠️ <b>Boot check inconclusive</b> ({symbol})\n"
+                f"The exchange could not be read at boot, so it is <b>unknown</b> "
+                f"whether a position exists without a database row. This is not a "
+                f"clean start — it is an unread one.")
+        return
+
+    for p in positions:
+        if float(p.get('contracts') or 0) <= 0:
+            continue
+        state_by_side[(p.get('side') or '').upper()] = p
+
+    if not state_by_side:
+        print(f"{LOG_PREFIX}[BOOT-ASSERT] venue FLAT for {symbol} — no orphan "
+              f"possible", flush=True)
+        return
+
+    with sqlite3.connect(DB_PATH) as conn:
+        rows = conn.execute(
+            "SELECT position_side FROM virtual_positions "
+            "WHERE symbol=? AND status='open' AND COALESCE(is_paper,1)=0",
+            (symbol,),
+        ).fetchall()
+        booked = {r[0] for r in rows}
+        booked |= {r[0] for r in conn.execute(
+            "SELECT position_side FROM active_positions WHERE symbol=?", (symbol,)
+        ).fetchall()}
+
+    for side_name, pos in state_by_side.items():
+        if side_name in booked:
+            print(f"{LOG_PREFIX}[BOOT-ASSERT] {side_name} open on venue and booked "
+                  f"in the DB — consistent", flush=True)
+            continue
+        _BOOT_ORPHAN_SIDES.add(side_name)
+        _sl = (pos.get('info') or {}).get('stopLoss') or ''
+        has_stop = bool(_sl) and str(_sl) not in ('0', '0.0', '')
+        detail = (f"contracts={pos.get('contracts')} entry={pos.get('entryPrice')} "
+                  f"stopLoss={_sl or 'NONE'}")
+        _record_naked_position(symbol, side_name, stage='boot_orphan', detail=detail)
+        print(f"{LOG_PREFIX}[BOOT-ASSERT] 🔴 ORPHAN: {side_name} open on venue with "
+              f"NO database row — {detail}", flush=True)
+        send_tg(f"🔴 <b>ORPHAN POSITION ON THE VENUE</b> ({symbol} {side_name})\n"
+                f"A position is open on Bybit that <b>no database row describes</b>. "
+                f"The bot is NOT managing it and will not close it.\n"
+                f"<code>{detail}</code>\n"
+                f"Stop on the venue: <b>{'YES — ' + str(_sl) if has_stop else '🔴 NONE'}</b>\n"
+                f"🔴 Account is on <b>CROSS margin</b>: an unstopped position draws on "
+                f"the whole wallet balance.\n"
+                f"<b>New {side_name} entries are BLOCKED</b> until this is resolved by "
+                f"hand (set a stop, or close it, then restart).")
+
