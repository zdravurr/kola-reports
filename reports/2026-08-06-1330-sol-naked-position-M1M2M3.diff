+    if res is None:
+        # POS_FLAT — _execute_close_position's "no position" return. The entry order
+        # did not leave a position, so there was never anything to protect.
+        print(f"{LOG_PREFIX}[SL-FAIL-SAFE] venue reports FLAT — no position was "
+              f"open; nothing was naked", flush=True)
+        send_tg(f"⚠️ <b>SL failed 3×</b> {symbol} {position_side}\n"
+                f"The emergency close found <b>no position on the venue</b> — the "
+                f"entry did not leave one. Nothing is unprotected. No action needed.")
+        raise EntryFailSafeError(
+            f'SL failed for {symbol} {position_side}; venue FLAT, no position existed',
+            status='sl_failed_no_position', naked=False)
+
+    send_tg(f"⚠️ <b>SL failed 3× — position CLOSED</b> {symbol} {position_side}\n"
+            f"The stop could not be set, so the position was emergency-closed at "
+            f"{res.get('fill_price')}. Nothing is unprotected.")
+    raise EntryFailSafeError(
+        f'SL failed for {symbol} {position_side}; position emergency-closed',
+        status='sl_failed_position_closed', naked=False)
+
